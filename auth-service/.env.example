AUTH_SERVICE_PORT=3003
AUTH_SERVICE_STORAGE=memory
AUTH_SERVICE_JWT_SECRET=coniiti-auth-service-secret
AUTH_SERVICE_JWT_EXPIRES_IN_SECONDS=7200
AUTH_SERVICE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SERVICE_REQUEST_BODY_LIMIT=100kb
AUTH_SERVICE_RATE_LIMIT_WINDOW_MS=900000
AUTH_SERVICE_LOGIN_RATE_LIMIT_MAX=10
AUTH_SERVICE_REGISTER_RATE_LIMIT_MAX=5
AUTH_SERVICE_RESET_RATE_LIMIT_MAX=5
AUTH_SERVICE_DB_HOST=localhost
AUTH_SERVICE_DB_PORT=3306
AUTH_SERVICE_DB_NAME=CONIITI_AUTH
AUTH_SERVICE_DB_USER=coniiti_app
AUTH_SERVICE_DB_PASSWORD=
AUTH_SERVICE_DB_BOOTSTRAP=false
